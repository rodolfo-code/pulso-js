# ──────────────────────────────────────────────────────────────
# Pulso JS — segredos do ambiente Docker
# Copie este arquivo para .env.docker e preencha:
#   docker compose --env-file .env.docker up -d
#
# ESTRATÉGIA A: este compose sobe SÓ o pulso-js. Os serviços compartilhados
# (Langfuse, observatory-postgres) vêm do compose do legado.
#
# Pré-requisito: subir o compose do legado primeiro:
#   cd ../../pulso/docker && docker compose --env-file ../.env.docker up -d
# ──────────────────────────────────────────────────────────────

# Porta exposta no host (interna do container é sempre 8000)
PORT=8000

# Connection string apontando pro container `observatory-postgres` do legado.
# O host `observatory-postgres` é resolvido pela rede externa compartilhada.
DATABASE_URL=postgresql://observatory:observatory@observatory-postgres:5432/observatory

# URL do Langfuse — host `langfuse-web` resolvido pela rede externa.
LANGFUSE_BASE_URL=http://langfuse-web:3000

# Nome da rede Docker externa criada pelo compose do legado.
# Por default, Docker Compose cria a rede como `<nome-do-diretório>_default`.
# Se o compose do legado roda em `pulso/docker/`, a rede default é `docker_default`.
# Verifique com: docker network ls
LEGACY_NETWORK_NAME=docker_default


# ──────────────────────────────────────────────────────────────────────────────
# Pulso JS — segredos do ambiente Docker
# Copie este arquivo para .env.docker e preencha os valores antes de rodar:
#   docker compose --env-file .env.docker up -d
#
# Esse compose sobe a stack INTEIRA (Langfuse + bancos + app pulso-js).
# Equivalente ao compose do legado — durante a travessia, suba só UM dos dois
# por vez (legado OU pulso-js) pra evitar conflito de portas/volumes.
# ──────────────────────────────────────────────────────────────────────────────

# ── Pulso JS (app) ────────────────────────────────────────────────────────────

# Chave de API obrigatória para todos os endpoints (exceto GET /health) — ALTERE
# (Exigida quando shared/auth for migrado; hoje o app ignora.)
OBSERVATORY_API_KEY=your-observatory-api-key-here

# ── Langfuse Web ──────────────────────────────────────────────────────────────

# Gere com: openssl rand -hex 32
NEXTAUTH_SECRET=

# Gere com: openssl rand -hex 32
SALT=

# Gere com: openssl rand -hex 32 (resultado em 64 chars hex)
ENCRYPTION_KEY=

# Senha do usuário admin criado automaticamente na primeira inicialização
LANGFUSE_INIT_USER_PASSWORD=

# ── Bancos de dados ───────────────────────────────────────────────────────────

# Senha do PostgreSQL do Langfuse
LANGFUSE_POSTGRES_PASSWORD=

# Senha do PostgreSQL do Observatory (consumido pelo pulso-js)
OBSERVATORY_POSTGRES_PASSWORD=

# ── ClickHouse ────────────────────────────────────────────────────────────────

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────

# Gere com: openssl rand -hex 16
REDIS_AUTH=

# ── MinIO ─────────────────────────────────────────────────────────────────────

MINIO_ROOT_USER=minio

# Gere com: openssl rand -hex 16
MINIO_ROOT_PASSWORD=
