            {
              "name": "POST /langfuse/score-configs",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"tenantSlug\": \"{{tenantSlug}}\",\n  \"name\": \"latency-ms\",\n  \"dataType\": \"NUMERIC\",\n  \"description\": \"Latência da resposta em milissegundos\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/langfuse/score-configs",
                  "host": ["{{baseUrl}}"],
                  "path": ["langfuse", "score-configs"]
                },
                "description": "Cria score-config. Aplica taxonomia (`buildScoreConfigName`): nome vira `{tenantSlug}/{name}`. NOTA: Langfuse v3 endureceu a regex de `name` e pode rejeitar nomes com `/` — issue conhecida."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Datasets",
          "item": [
            {
              "name": "GET /langfuse/datasets",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/langfuse/datasets",
                  "host": ["{{baseUrl}}"],
                  "path": ["langfuse", "datasets"]
                },
                "description": "Lista datasets."
              },
              "response": []
