# ──────────────────────────────────────────────
# Pulso JS — variáveis de ambiente (app local sem Docker)
# Copie este arquivo para .env e preencha os valores
# ──────────────────────────────────────────────

# Porta HTTP do servidor (default: 8000)
PORT=8000

# ── PostgreSQL ───────────────────────────────
# Formato: postgresql://<user>:<password>@<host>:<port>/<dbname>
# NOTA: NÃO usar o dialeto `+asyncpg` do Python (SQLAlchemy). Em Node o adapter-pg
# espera o formato puro `postgresql://...`.
DATABASE_URL=postgresql://observatory:observatory@localhost:5433/observatory

# ── Langfuse (self-hosted) ────────────────────
# URL base da instância Langfuse (sem barra final)
LANGFUSE_BASE_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Envs abaixo serão exigidas conforme módulos forem migrados:
# - LANGFUSE_PUBLIC_KEY        → Fase 2 (langfuse-proxy)
# - LANGFUSE_SECRET_KEY        → Fase 2 (langfuse-proxy)
# - OBSERVATORY_API_KEY        → quando shared/auth migrar
# - HEARTBEAT_TIMEOUT_SECONDS  → Fase 3 (agents)
# - CONVERSATION_SLOW_THRESHOLD_MS → Fase 6 (observations)
# - LOG_LEVEL                  → quando shared/http logging interceptor migrar
# ──────────────────────────────────────────────